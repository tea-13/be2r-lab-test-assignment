# Справочные пути для будущих конфигов; Makefile и upstream НЕ читают этот файл автоматически.
DATA_ROOT=./data/datasets
WEIGHTS_ROOT=./data/weights
RESULTS_ROOT=./results
# OneMap: в этапе 2 передать через его Compose env-file; LOCAL исключает загрузку сцен,
# но авторский Dockerfile всё равно скачивает веса и эпизоды.
HM3D=LOCAL
HM3D_PATH=/absolute/path/to/data/datasets/hm3d-v0.2/versioned_data
# Credentials не нужны для LOCAL. Секреты не добавлять в Git.
